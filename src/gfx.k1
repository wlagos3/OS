

let(mutable, extern("ramfb_fb")) fb: array[array[u32, 1920], 1080]


fn draw-glyph(x: int, y: int, c: u8, fg: u32, bg: u32, scale: int ): empty {
  let base = c.widen[int] * 16
  for r in 0.until(16){
    let row = FONT.[base + r]
    let mask: u8 = 0b1000_0000
    for bx in 0.until(8){
      if row.bit-and(mask) != 0
        fill-rect(x + bx * scale, y + r * scale, scale, scale, fg )
      else fill-rect(x + bx * scale, y + r * scale, scale, scale, bg )
      mask = mask.shift-right(1)
    }
  }
}


fn fill-rect(x: int, y: int, w: int, h: int, color: u32): empty {
  let x0 = x; let y0 = y; let x1 = x + w; let y1 = y + h
  x0 = max(x0, 0); y0 = max(y0, 0); x1 = min(x1, 1920); y1 = min(y1, 1080)

  if x0 >= x1 or y0 >= y1 return

  for row in y0.until(y1) {
    for col in x0.until(x1) {
      fb.[row].[col] = color
    }
  }
}
