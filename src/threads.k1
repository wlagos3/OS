ns threads {
  let(mutable) threads: list[*thread] = list/empty()
  let(mutable) current-thread: int = 0

  fn(extern("context_switch")) context-switch(a-ctx: *array[u64,13], b-ctx: *array[u64, 13])

  type thread-state = either {ready, running, blocked, dead}

  type thread = {
    name: string,
    state: thread-state,
    ctx: array[u64, 13],
    entry: *fn() -> empty
  }


  fn yield(): empty {
    let n = threads.len()
    let old = threads.[current-thread]


    let next = -1
    for i in 1.until(n + 1) {
      let candidate = (current-thread + i) % n
      if threads.[candidate].state is :ready {
        next = candidate
        break
      }
    }

    if next == current-thread return
    if next == -1 panic("no threads to run")

    let new = threads.[next]
    if old.state is :running {old.state = :ready}
    new.state = :running
    current-thread = next
    println("picked ${new.name}")
    context-switch(old.ctx.&, new.ctx.&)

  }


  fn start-thread(): never {
    let t = threads.[current-thread]
    let entry = t.entry
    entry()
    t.state = :dead
    loop {yield()}
  }



  fn spawn(name: string, body: *fn() -> empty): int {
    let t: *thread = mem/current-arena().alloc-t[thread]()
    t.* = .{name, state = :ready, entry = body, ctx = array/zeroed[u64, 13]()}
    let stack = mem-reserve(16 * 1024).to-size()
    t.ctx.[12] = (stack + 16 * 1024).unsigned()
    t.ctx.[11] = start-thread.&.as[ptr].to-uint()
    threads.push(t)
    threads.len() - 1
  }

  //temp
}
