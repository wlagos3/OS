ns threads {
  fn(extern("context_switch")) context-switch(a-ctx: *ctx, b-ctx: *ctx)

  let(mutable) threads: pool[thread] = .0
  let(mutable) current-thread: pool/handle[thread] = .0


  type thread-handle = pool/handle[thread]
  type sleeping-thread = {handle: thread-handle, until: u64}

  let(mutable) ready-threads: ring[thread-handle, 256] = .0
  let(mutable) sleepers: fixlist[sleeping-thread, 256] = .0


  type ctx = {
    x19: u64,
    x20: u64,
    x21: u64,
    x22: u64,
    x23: u64,
    x24: u64,
    x25: u64,
    x26: u64,
    x27: u64,
    x28: u64,
    x29: u64,
    x30: u64,
    sp: ptr
  }

  type thread-state = either {ready, running, blocked, dead}

  type thread = {
    name: string,
    state: thread-state,
    ctx: ctx,
    entry: *fn() -> empty
  }


  fn make-ready(handle: thread-handle) {
    let thread = threads.get(handle)
    thread.state = :ready
    ready-threads.push(handle)
    .0
  }

  fn wake-sleepers() {
    let now = time/now()

    while sleepers.len() > 0 and sleepers.[0].until <= now {
      let to-wake: sleeping-thread = sleepers.[0]

      let i = 0
      while i < sleepers.len() - 1 {
        sleepers.[i] = sleepers.[i + 1]
        i = i + 1
      }
      sleepers.pop()

      if threads.is-live(to-wake.handle) {make-ready(to-wake.handle)}
    }
  }



  fn yield(): empty {
    critical({
      wake-sleepers()
      let n = threads.len()
      let old = threads.get(current-thread)

      let next-handle = if ready-threads.pop() is {
        :some(handle) -> handle,
        :none -> if old.state is :running {return} else panic("ready queue empty, todo")
      }

      let next = threads.get(next-handle)

      if old.state is :running {make-ready(current-thread)}
      next.state = :running
      current-thread = next-handle
      context-switch(old.ctx.&, next.ctx.&)
    })
  }


  fn start-thread(): never {
    irq-enable()
    let t = threads.get(current-thread)
    let entry = t.entry
    entry()
    t.state = :dead
    loop {yield()}
  }


  fn spawn(name: string, entry: *fn() -> empty): int {critical({
    let thread-handle = threads.acquire(.{name, state = :ready, entry, ctx = .0})

    let stack = mem-reserve(16 * 1024)

    threads.get(thread-handle).ctx.sp = stack.add-bytes(16 * 1024)
    threads.get(thread-handle).ctx.x30 = start-thread.&.as[ptr].to-uint()

    ready-threads.push(thread-handle)
    threads.len() - 1
  })}


  fn sleep(ms: u64): empty {critical({
    let sleeper: sleeping-thread = .{handle = current-thread, until = (time/now() + time/ms-to-ticks(ms))}
    sleepers.push(sleeper)

    //sleepers is sorted by wake time

    let i = sleepers.len() - 1

    while i > 0 and sleepers.[i - 1].until > sleeper.until {
      sleepers.[i] = sleepers.[i - 1]
      i = i - 1
    }
    sleepers.[i] = sleeper

    let current = threads.get(current-thread)
    current.state = :blocked
    yield()
  })}

  //temp
}
